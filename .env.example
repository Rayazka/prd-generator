# Copy to .env.local and fill in. Never commit .env*.local.
# Lihat Part B (B4) untuk makna tiap var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_API_KEY=
# Default model bila AI_MODEL kosong: gpt-4o-mini
AI_MODEL=
# Default bila kosong: 20
AI_DAILY_QUOTA=
# Default bila kosong (ms): 60000
AI_TIMEOUT_MS=
# 32 random bytes encoded as 64 hexadecimal characters; keep stable for stored user keys.
KEYS_ENC_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
